#!/usr/bin/env bash
#
# Generate the workbench's machine-local configuration in workbench/local/,
# which git ignores. Nothing written here belongs in any image or branch.
#
# Writes:
#   workbench.env     settings and generated secrets (mode 600)
#   registry.env      environment for the Registry container
#   database.env      environment for the database container
#   000-comanage.conf Apache virtual hosts for both listeners
#   htpasswd          test-login accounts, all sharing one generated password
#
# Re-running keeps every value already in workbench.env and rewrites the
# derived files. Optional inputs, read from the environment on any run:
#   REGISTRY_CHECKOUT                path to the COmanage Registry checkout
#   WORKBENCH_CILOGON_CLIENT_ID      CILogon OIDC client for the maintainer login
#   WORKBENCH_CILOGON_CLIENT_SECRET
#   WORKBENCH_MAINTAINER_LOGIN       the maintainer's CILogon subject (sub);
#                                    seeded as an allowed platform administrator
#   WORKBENCH_CILOGON_PORT           loopback port for CILogon login (8443)
#   WORKBENCH_TESTLOGIN_PORT         loopback port for the test login (8444)
#
# Usage: workbench/bin/make-local-config
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

umask 077
mkdir -p "$WORKBENCH_LOCAL"
env_file="$WORKBENCH_LOCAL/workbench.env"
touch "$env_file"

platform_admin="wb-platform-admin"

random_secret() {
  openssl rand -hex 24
}

pick() {
  local key="$1" from_env="$2" default="$3" stored
  stored="$(local_value "$key")"
  if [ -n "$from_env" ]; then
    echo "$from_env"
  elif [ -n "$stored" ]; then
    echo "$stored"
  else
    echo "$default"
  fi
}

registry_checkout="$(pick REGISTRY_CHECKOUT "${REGISTRY_CHECKOUT:-}" "")"
cilogon_port="$(pick CILOGON_PORT "${WORKBENCH_CILOGON_PORT:-}" 8443)"
testlogin_port="$(pick TESTLOGIN_PORT "${WORKBENCH_TESTLOGIN_PORT:-}" 8444)"
cilogon_client_id="$(pick CILOGON_CLIENT_ID "${WORKBENCH_CILOGON_CLIENT_ID:-}" "")"
cilogon_client_secret="$(pick CILOGON_CLIENT_SECRET "${WORKBENCH_CILOGON_CLIENT_SECRET:-}" "")"
maintainer_login="$(pick MAINTAINER_LOGIN "${WORKBENCH_MAINTAINER_LOGIN:-}" "")"
db_password="$(pick DB_PASSWORD "" "$(random_secret)")"
test_login_password="$(pick TEST_LOGIN_PASSWORD "" "$(random_secret)")"
oidc_passphrase="$(pick OIDC_CRYPTO_PASSPHRASE "" "$(random_secret)")"
security_salt="$(pick SECURITY_SALT "" "$(openssl rand -hex 20)")"

cat > "$env_file" <<EOF
# Workbench local settings. Generated by workbench/bin/make-local-config.
# Holds secrets: never commit, copy into an issue, or paste into a PR.
REGISTRY_CHECKOUT=$registry_checkout
CILOGON_PORT=$cilogon_port
TESTLOGIN_PORT=$testlogin_port
CILOGON_CLIENT_ID=$cilogon_client_id
CILOGON_CLIENT_SECRET=$cilogon_client_secret
MAINTAINER_LOGIN=$maintainer_login
DB_PASSWORD=$db_password
TEST_LOGIN_PASSWORD=$test_login_password
OIDC_CRYPTO_PASSPHRASE=$oidc_passphrase
SECURITY_SALT=$security_salt
EOF

allowlist="$platform_admin"
if [ -n "$maintainer_login" ]; then
  allowlist="$allowlist,$maintainer_login"
fi

cat > "$WORKBENCH_LOCAL/database.env" <<EOF
POSTGRES_USER=registry_user
POSTGRES_PASSWORD=$db_password
POSTGRES_DB=registry
EOF

cat > "$WORKBENCH_LOCAL/registry.env" <<EOF
COMANAGE_REGISTRY_DATABASE_HOST=database
COMANAGE_REGISTRY_DATABASE=registry
COMANAGE_REGISTRY_DATABASE_USER=registry_user
COMANAGE_REGISTRY_DATABASE_USER_PASSWORD=$db_password
COMANAGE_REGISTRY_HTTP_NO=1
COMANAGE_REGISTRY_VIRTUAL_HOST_FQDN=localhost
COMANAGE_REGISTRY_ADMIN_GIVEN_NAME=Workbench
COMANAGE_REGISTRY_ADMIN_FAMILY_NAME=PlatformAdmin
COMANAGE_REGISTRY_ADMIN_USERNAME=$platform_admin
COMANAGE_REGISTRY_SECURITY_SALT=$security_salt
COMANAGE_REGISTRY_OA4MP_ADMIN_USERS=$allowlist
WORKBENCH_MAINTAINER_LOGIN=$maintainer_login
EOF

# Apache virtual hosts. The image's entrypoint keeps an existing
# 000-comanage.conf, so this file replaces the one it would generate.
vhost="$WORKBENCH_LOCAL/000-comanage.conf"

common_stanza() {
  cat <<'EOF'
UseCanonicalName Off

SSLEngine on
SSLProtocol all -SSLv2 -SSLv3
SSLCertificateFile /etc/apache2/cert.pem
SSLCertificateKeyFile /etc/apache2/privkey.pem

Header set Content-Security-Policy "frame-ancestors 'self';"

DocumentRoot /var/www/html
RedirectMatch ^/$ /registry/
LogLevel warn
ErrorLog ${APACHE_LOG_DIR}/error.log
CustomLog ${APACHE_LOG_DIR}/access.log combined
EOF
}

{
  echo "# Generated by workbench/bin/make-local-config. Do not commit."
  echo "Listen 8444"
  echo
  echo "# Listener for the maintainer: CILogon login."
  echo "<VirtualHost *:443>"
  echo "ServerName https://localhost:$cilogon_port"
  common_stanza
  if [ -n "$cilogon_client_id" ] && [ -n "$cilogon_client_secret" ]; then
    cat <<EOF

OIDCProviderMetadataURL https://cilogon.org/.well-known/openid-configuration
OIDCRemoteUserClaim sub
OIDCClientID $cilogon_client_id
OIDCClientSecret $cilogon_client_secret
OIDCScope "openid email profile org.cilogon.userinfo"
OIDCCryptoPassphrase $oidc_passphrase
OIDCRedirectURI https://localhost:$cilogon_port/secure/redirect
OIDCSessionInactivityTimeout 3600
OIDCSessionMaxDuration 3600

<Location /secure/redirect>
AuthType openid-connect
Require valid-user
</Location>

<Directory /var/www/html/registry>
Options Indexes FollowSymLinks
DirectoryIndex index.php
AllowOverride All
AuthType openid-connect
OIDCUnAuthAction pass
Require valid-user
</Directory>

<Directory /var/www/html/registry/auth/login>
AuthType openid-connect
OIDCUnAuthAction auth
Require valid-user
</Directory>
EOF
  else
    cat <<'EOF'

<Directory /var/www/html/registry>
Options Indexes FollowSymLinks
DirectoryIndex index.php
AllowOverride All
Require all granted
</Directory>

# No CILogon client is configured, so this listener offers no login.
<Directory /var/www/html/registry/auth/login>
Require all denied
ErrorDocument 403 "Workbench: CILogon login is not configured on this listener."
</Directory>
EOF
  fi
  echo "</VirtualHost>"
  echo
  echo "# Listener for agents: local test login with basic authentication."
  echo "<VirtualHost *:8444>"
  echo "ServerName https://localhost:$testlogin_port"
  common_stanza
  cat <<'EOF'

<Directory /var/www/html/registry>
Options Indexes FollowSymLinks
DirectoryIndex index.php
AllowOverride All
Require all granted
</Directory>

<Directory /var/www/html/registry/auth/login>
AuthType Basic
AuthName "Workbench test login"
AuthBasicProvider file
AuthUserFile /etc/apache2/workbench/htpasswd
Require valid-user
</Directory>
</VirtualHost>
EOF
} > "$vhost"

: > "$WORKBENCH_LOCAL/htpasswd"
for login in "${WORKBENCH_TEST_LOGINS[@]}"; do
  htpasswd -bB "$WORKBENCH_LOCAL/htpasswd" "$login" "$test_login_password" 2>/dev/null
done

# Apache reads the virtual host file as root at startup, so it stays private.
# Its workers run as www-data and read the password file on each login; it
# holds only bcrypt hashes.
chmod 644 "$WORKBENCH_LOCAL/htpasswd"

echo "==> Wrote $WORKBENCH_LOCAL"
if [ -z "$registry_checkout" ]; then
  echo "    REGISTRY_CHECKOUT is not set; build-image needs --registry PATH."
fi
if [ -z "$cilogon_client_id" ]; then
  echo "    CILogon login is not configured; the maintainer listener offers no login."
fi
