# Live-server tier credentials (U9). Copy to Test/.env and fill in.
#
# Test/.env is gitignored and must never be committed: it carries a real
# dev.cilogon.org admin-client secret. In CI these come from the `live-server`
# GitHub Environment instead, which is restricted to the main branch.
#
# Use a DEDICATED admin client provisioned solely for testing on
# dev.cilogon.org, scoped to the minimum privileges it needs and distinct from
# any staff or production credential, so a leak has a bounded blast radius.

# The admin client's OA4MP server endpoint.
OA4MP_LIVE_SERVER_URL=https://dev.cilogon.org/oauth2/oidc-cm

# The dedicated test admin client's identifier and secret.
OA4MP_LIVE_ADMIN_IDENTIFIER=
OA4MP_LIVE_ADMIN_SECRET=

# The CO the admin client belongs to; used to build the client comment URL.
OA4MP_LIVE_CO_ID=2
