<?xml version="1.0" encoding="UTF-8"?>
<!--
  Two suites, run separately by tests/run.sh:
    unit         tests/Unit: framework-free code, no database, no network.
    integration  tests/TestCase: tables, controllers and permissions inside a
                 Registry 5 container against a throwaway test database.
  The bootstrap picks the setup from OA4MP_TEST_SUITE; see tests/README.md.

  No run history is recorded, because the plugin is mounted read-only.
-->
<phpunit
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:noNamespaceSchemaLocation="/srv/comanage-registry/app/vendor/phpunit/phpunit/phpunit.xsd"
  bootstrap="tests/bootstrap.php"
  recordTestRunHistory="false"
  colors="false"
  beStrictAboutOutputDuringTests="true"
  failOnRisky="true"
  failOnWarning="true"
  failOnEmptyTestSuite="true"
>
  <php>
    <ini name="memory_limit" value="-1"/>
  </php>

  <testsuites>
    <testsuite name="unit">
      <directory>tests/Unit</directory>
    </testsuite>
    <testsuite name="integration">
      <directory>tests/TestCase</directory>
    </testsuite>
  </testsuites>
</phpunit>
